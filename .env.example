# Solo servidor (Vercel: sin prefijo VITE; no se incluye en el bundle del navegador)
# La capa estructurada mantiene Anthropic por defecto. Cambiar el proveedor sólo
# mediante variables de entorno permite probar OpenAI en Preview sin tocar código.
STRUCTURED_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_PROGRAMMING_MODEL=claude-sonnet-4-6

# Para una prueba OpenAI aislada, cambia STRUCTURED_AI_PROVIDER a "openai" y
# configura también las dos variables siguientes. No existe fallback implícito:
# si falta la clave o el modelo, el endpoint falla cerrado.
# OPENAI_API_KEY=
# OPENAI_PROGRAMMING_MODEL=

# Orígenes extra permitidos para /api/anthropic y /api/programming-week-briefing (coma, ; o salto de línea).
# Por defecto ya entran localhost, producción y URLs https://programing-evo*.vercel.app .
# Úsalo si sirves la app desde un dominio propio, p. ej. https://evo.tudominio.com
# EVO_ALLOWED_ORIGIN_PREFIXES=https://evo.tudominio.com

# Cliente (coach, publicar semana en Supabase)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Piloto Nucleus: activar ambos únicamente en Preview/staging.
# El endpoint sigue exigiendo Auth individual + capability programming.manage.
NUCLEUS_EVENTS_ENABLED=false
VITE_NUCLEUS_PILOT_ENABLED=false

# Transición EVO Coach: activar ambos únicamente en Preview/staging hasta retirar
# por completo el código compartido. Con sesión individual no se envía accessCode.
COACH_INDIVIDUAL_AUTH_ENABLED=false
VITE_COACH_INDIVIDUAL_AUTH_ENABLED=false
COACH_SHARED_CODE_FALLBACK_ENABLED=true
VITE_COACH_SHARED_CODE_FALLBACK_ENABLED=true

# Opcional y temporal: código compartido para el rollback durante la transición.
# Si no se define aquí ni en localStorage, el acceso compartido queda denegado.
# VITE_COACH_ACCESS_CODE=

# ── Panel «Contenido Coach» (solo servidor en Vercel; NO uses prefijo VITE_) ──
# COACH_GUIDE_ADMIN_SECRET
#   → Cualquier contraseña larga que TÚ inventes (ej. 32+ caracteres aleatorios).
#   → Es la clave que escribes en el panel al guardar. NO es el código compartido de coaches.
#
# SUPABASE_SERVICE_ROLE_KEY
#   → Supabase Dashboard → tu proyecto → Project Settings (engranaje) → API
#   → Bloque "Project API keys" → clave "service_role" (Secret). Copiar entera.
#   → Nunca la pongas en VITE_ ni en el front: bypassa RLS.
#
# SUPABASE_URL (opcional en Vercel)
#   → Mismo valor que VITE_SUPABASE_URL (https://TU_REF.supabase.co).
#   → Si solo tienes VITE_SUPABASE_URL en Vercel, la API ya la usa como fallback.
#
# COACH_GUIDE_ADMIN_SECRET=pon_aqui_tu_secreto_largo
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_URL=https://xxxx.supabase.co

# Opcional: modelo Claude programación / agente (por defecto claude-sonnet-4-6)
# VITE_CLAUDE_MODEL=claude-sonnet-4-6
# Opcional: modelo chat soporte coach ?coach (por defecto claude-haiku-4-5-20251001)
# VITE_CLAUDE_SUPPORT_MODEL=claude-haiku-4-5-20251001

# ── Cuarentena method_rules legacy (53 filas sin revisar) — solo servidor, sin VITE_ ──
# Deshabilitadas por defecto hasta revisión formal de las reglas antiguas.
# METHOD_RULE_LEGACY_READ_ENABLED=false
#   → Si no es exactamente "true", el briefing NO lee method_rules ni incluye ese bloque.
# METHOD_RULE_LEGACY_WRITE_ENABLED=false
#   → Si no es exactamente "true", POST /api/method-rule responde 403 sin escribir en Supabase.
METHOD_RULE_LEGACY_READ_ENABLED=false
METHOD_RULE_LEGACY_WRITE_ENABLED=false

# ── Importar programación desde Google Drive (panel «Tu método» → Contexto de otros mesociclos) ──
# GOOGLE_DRIVE_PROGRAMMING_SA_JSON_B64
#   → Contenido del JSON de la cuenta de servicio en base64 (recomendado en Vercel; evita problemas con comillas).
#   → Google Cloud Console: proyecto → APIs y servicios → Biblioteca → «Google Drive API» Activar.
#   → IAM → Cuentas de servicio → Crear → Claves → JSON. Copiar el archivo y: base64 -i service.json | pbcopy
# GOOGLE_DRIVE_PROGRAMMING_SA_JSON
#   → Alternativa: pegar el JSON completo en una sola línea (escapando saltos de línea del private_key).
# GOOGLE_DRIVE_PROGRAMMING_FOLDER_ID (opcional)
#   → ID de carpeta por defecto si no lo pegas en el panel. En Drive: URL …/folders/ESTE_ID
# En Drive: botón derecho en la carpeta de programación → Compartir → añadir el «client_email» del JSON con rol Lector.
