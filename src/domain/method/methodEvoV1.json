  "global_rules": [
    {
      "id": "EVO-GEN-001",
      "level": "hard",
      "scope": "week",
      "text": "Programar la semana completa dentro del mesociclo, no días aislados."
    },
    {
      "id": "EVO-GEN-002",
      "level": "hard",
      "scope": "workflow",
      "text": "Diseñar primero EvoFuncional y auditar después todas las modalidades juntas."
    },
    {
      "id": "EVO-GEN-003",
      "level": "hard",
      "scope": "session",
      "text": "La fuerza, técnica o skill y el bloque final deben complementarse y no saturar sin intención el mismo patrón o zona de fatiga."
    },
    {
      "id": "EVO-GEN-004",
      "level": "operational",
      "scope": "history",
      "text": "Revisar 4-6 semanas recientes y ponderar más las aprobadas y recientes."
    },
    {
      "id": "EVO-GEN-005",
      "level": "operational",
      "scope": "variety",
      "text": "Comparar patrón, ejercicio, implemento, formato, experiencia, día fijo y compatibilidad entre modalidades. Rediseñar si coinciden tres o más ejes sin progresión justificada."
    },
    {
      "id": "EVO-GEN-006",
      "level": "preference",
      "scope": "week",
      "text": "Incluir al menos un momento memorable semanal sin aumentar el caos logístico."
    },
    {
      "id": "EVO-GEN-007",
      "level": "hard",
      "scope": "offer",
      "text": "No programar ni generar feedback para una clase no ofertada."
    },
    {
      "id": "EVO-GEN-008",
      "level": "operational",
      "scope": "fatigue",
      "text": "Auditar hombro, lumbar, agarre, rodilla, carga axial, impacto, carrera y unilateralidad en días consecutivos y rutas mixtas."
    },
    {
      "id": "EVO-GEN-009",
      "level": "preference",
      "scope": "cross_class",
      "text": "Compartir una familia de intención entre modalidades cuando ayude, sin obligar al mismo ejercicio o patrón exacto."
    },
    {
      "id": "EVO-GEN-010",
      "level": "hard",
      "scope": "learning",
      "text": "Una regla automática no modifica un no negociable y requiere aprobación de Marian antes de escribirse en el método."
    },
    {
      "id": "EVO-GEN-011",
      "level": "operational",
      "scope": "strength",
      "text": "No dejar 3-4 minutos vacíos entre series de un único movimiento. Una cadencia de 3 minutos o más se usa para combinar un básico con un segundo movimiento o accesorio; en un movimiento único se acorta la cadencia. La excepción son las últimas series de la S6 cuando se busca o verifica un RM, con hasta 3 minutos."
    },
    {
      "id": "EVO-GEN-012",
      "level": "operational",
      "scope": "variety",
      "text": "No convertir la semana de Funcional en una sucesión de WODs por intervalos. Rotar AMRAP, por tiempo, ladder, chipper, partner, team, relevos, bloques continuos e intervalos; si se repiten intervalos, cambiar claramente duración, relación trabajo-descanso y estímulo."
    },
    {
      "id": "EVO-GEN-013",
      "level": "operational",
      "scope": "force_mesocycle",
      "text": "En el mesociclo de fuerza, programar básicos en la mayoría de los días de EvoFuncional donde la fatiga y la logística lo permitan. Elegir estratégicamente squat, deadlift, press, floor press, row y pull-up para alcanzar el porcentaje o RIR buscado sin repetir fatiga por inercia."
    },
    {
      "id": "EVO-GEN-014",
      "level": "operational",
      "scope": "weightlifting",
      "text": "Incluir halterofilia en casi todas las semanas del mesociclo de fuerza para que exista enseñanza y progresión. La exposición principal se programa en fuerza o técnica, no dentro de un WOD complejo, y progresa hacia cargas medias-altas con repeticiones limpias y sin fallo."
    },
    {
      "id": "EVO-GEN-015",
      "level": "operational",
      "scope": "setup_logistics",
      "text": "Amortizar los montajes costosos. Si se prepara landmine, barras cargadas, racks, bancos, trineos u otro recurso con montaje, traslado o reparto relevante, reutilizarlo en dos o más bloques o en varios movimientos de una parte larga. Puede convivir con otros materiales, pero no debe aparecer como un único ejercicio aislado salvo motivo técnico, de seguridad o fatiga explícito."
    },
    {
      "id": "EVO-GEN-016",
      "level": "hard",
      "scope": "basics_complexity",
      "text": "En EvoBasics puede enseñarse un skill complejo y aplicarse después con carga, volumen y fatiga controlados, pero el resto del WOD debe ser sencillo y reconocible. No acumular varios movimientos complejos o coordinativos dentro del mismo bloque de acondicionamiento."
    },
    {
      "id": "EVO-GEN-017",
      "level": "hard",
      "scope": "basics_skill_rotation",
      "text": "La rotación de EvoBasics avanza por clases realmente impartidas, no por semanas naturales. Cada bloque móvil de cinco clases contiene exactamente dos skills complejos y tres sencillos; una clase cancelada o no ofertada no avanza la rotación."
    },
    {
      "id": "EVO-GEN-018",
      "level": "operational",
      "scope": "basics_movement_banks",
      "text": "La checklist de skills controla qué se enseña, pero no limita el banco del entrenamiento. Fuerza, WOD y accesorios pueden usar movimientos ya conocidos, core, burpees, carries, carrera, máquinas, lunges, saltos sencillos, kettlebell, dumbbell, pelotas y landmine para conservar variedad y condición física."
    }
  ],
